# ─────────────────────────────────────────────────────────────────────────────
# Root environment for docker-compose (.prod) — copy to `.env` and fill in.
# The backend has its own richer template at backend/.env.example; per-deployment-mode
# templates live in deploy/ (env.saas.example, env.single-tenant.example, env.air-gapped.example).
# NEVER commit a populated .env.
# ─────────────────────────────────────────────────────────────────────────────

# Database (compose provisions Postgres with these).
POSTGRES_USER=edip
POSTGRES_PASSWORD=
POSTGRES_DB=edip

# Required app secrets. Generate with: python scripts/generate_secrets.py
JWT_SECRET_KEY=
MASTER_KEK=

# Deployment mode: saas | single_tenant | private_cloud | air_gapped
DEPLOYMENT_MODE=saas

# LLM + embeddings providers (cloud baseline for saas).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Frontend → backend URL (baked into the client bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Allowed CORS origin(s) for the frontend.
CORS_ALLOW_ORIGINS=http://localhost:3000
