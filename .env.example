# ─────────────────────────────────────────────────────────────────────────────
# Root environment for docker-compose (.prod) — copy to `.env` and fill in.
# The backend has its own richer template at backend/.env.example; per-deployment-mode
# templates live in deploy/ (env.saas.example, env.single-tenant.example, env.air-gapped.example).
# NEVER commit a populated .env.
# ─────────────────────────────────────────────────────────────────────────────

# Database (compose provisions Postgres with these).
POSTGRES_USER=edip
POSTGRES_PASSWORD=
POSTGRES_DB=edip

# Required app secrets. Generate with: python scripts/generate_secrets.py
JWT_SECRET_KEY=
MASTER_KEK=

# Deployment mode: saas | single_tenant | private_cloud | air_gapped
DEPLOYMENT_MODE=saas

# LLM + embeddings providers (cloud baseline for saas).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Frontend → backend URL. NEXT_PUBLIC_API_URL is baked at build time; for a hosted
# deploy set BACKEND_API_URL on the frontend service instead (read at runtime via
# /api/runtime-config) so one image can target any backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Allowed CORS origin(s) for the frontend.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── Phase D: hosted SaaS (signup + email + billing) ───────────────────────────────
# Public URL of the frontend — used to build invite/reset links in emails.
FRONTEND_BASE_URL=http://localhost:3000
# Outbound email (invites + password reset). See backend/.env.example for all SMTP_*.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_FROM=Sales Assistant <noreply@example.com>
# Self-serve signup gate.
ENABLE_SIGNUP=true
# Billing (plan limits + Stripe). OFF unless you wire Stripe; needs the [billing] extra.
ENABLE_BILLING=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
