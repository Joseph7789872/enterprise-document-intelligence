# ─────────────────────────────────────────────────────────────────────────────
# Deployment mode: SAAS (multi-tenant cloud).
# Cloud baseline (Anthropic + OpenAI) for ordinary documents; confidential/privileged
# documents route to a self-hosted vLLM endpoint. Per-tenant policy can tighten this
# further via the admin tenant-settings API.
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEPLOYMENT_MODE=saas

# Secrets (generate real values — see backend/.env.example for commands).
JWT_SECRET_KEY=
MASTER_KEK=

# Cloud baseline.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Self-hosted profile for sensitive docs (omit LLM_BASE_URL to disable → sensitive
# queries then FAIL CLOSED with 503 rather than going to the cloud).
LLM_BASE_URL=http://vllm:8000/v1
SELF_HOSTED_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Documents at/above this classification route to the self-hosted profile.
SENSITIVE_CLASSIFICATION=confidential
