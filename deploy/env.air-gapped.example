# ─────────────────────────────────────────────────────────────────────────────
# Deployment mode: AIR_GAPPED (also use this shape for private_cloud).
# Fully private — NO data leaves customer infrastructure. The app REFUSES TO START if
# any cloud provider (Anthropic LLM, OpenAI embeddings, Langfuse Cloud, cloud RAGAS
# judge) is configured. Everything runs inside the compose network.
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEPLOYMENT_MODE=air_gapped

JWT_SECRET_KEY=
MASTER_KEK=

# Self-hosted LLM (required). Empty LLM_BASE_URL → startup fails (fail-closed).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://vllm:8000/v1
SELF_HOSTED_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Self-hosted embeddings. Option A: an OpenAI-compatible server (TEI) as below.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://tei:80/v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
# Option B: in-process embeddings (no embedding server) — build the backend image with
# `--extra local`, then set instead:
#   EMBEDDING_PROVIDER=sentence_transformers
#   LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   EMBEDDING_DIMENSIONS=384

# Cloud-only features must be off in air-gapped mode (the validator enforces this).
OBSERVABILITY_PROVIDER=fake
EVALS_PROVIDER=fake
RERANKER_PROVIDER=fake
