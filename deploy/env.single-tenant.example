# ─────────────────────────────────────────────────────────────────────────────
# Deployment mode: SINGLE_TENANT.
# One customer, dedicated instance. The self-hosted endpoint is the baseline for ALL
# inference, but the instance may still use cloud embeddings if the customer permits.
# (For zero third-party egress, prefer private_cloud / air_gapped instead.)
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEPLOYMENT_MODE=single_tenant

JWT_SECRET_KEY=
MASTER_KEK=

# Self-hosted LLM as the baseline for every node.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://vllm:8000/v1
SELF_HOSTED_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Embeddings: self-hosted via an OpenAI-compatible server (set EMBEDDING_DIMENSIONS to
# the model's output size and ingest into a fresh DB).
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://tei:80/v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Tracing/evals: keep local unless the customer opts into cloud.
OBSERVABILITY_PROVIDER=fake
EVALS_PROVIDER=fake
