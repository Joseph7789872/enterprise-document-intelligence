# ─────────────────────────────────────────────────────────────────────────────
# Enterprise Document Intelligence Platform — backend environment template.
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Deployment environment: "development" | "staging" | "production".
# In non-development environments the app fails fast if required secrets are weak/missing.
ENVIRONMENT=development

# ── Database ────────────────────────────────────────────────────────────────
# Async driver (asyncpg) for the running app. Alembic derives a sync URL from this.
DATABASE_URL=postgresql+asyncpg://edip:edip_dev_password@localhost:5432/edip

# ── Redis (used by later phases: background ingestion, rate limiting) ─────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication (JWT) ──────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-dev-only-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Encryption (envelope: master KEK wraps per-record DEKs) ───────────────────
# Base64-encoded 32-byte (256-bit) key. Generate:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# In production this is supplied by a KMS/CMEK provider rather than env.
MASTER_KEK=
# Current key version for newly-encrypted data (lets us rotate keys later).
ENCRYPTION_KEY_VERSION=1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend. Locked down by default.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── Compliance ────────────────────────────────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=2555  # ~7 years; tune per customer/regulatory policy.

# ── Document ingestion (Phase 1) ────────────────────────────────────────────────
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt

# Blob storage: "local" for dev, "s3" for MinIO / S3-compatible object storage.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
# For STORAGE_BACKEND=s3 (MinIO example: S3_ENDPOINT_URL=http://localhost:9000):
S3_ENDPOINT_URL=
S3_BUCKET=edip-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Embeddings provider (Phase 1 + Phase 7):
#   openai                — OpenAI cloud (needs OPENAI_API_KEY).
#   openai_compatible     — self-hosted endpoint at EMBEDDING_BASE_URL (vLLM/Ollama/TEI).
#   sentence_transformers — in-process local model (needs `uv sync --extra local`).
#   fake                  — deterministic dev/test embeddings.
# In development a provider with missing prerequisites auto-falls back to "fake".
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
# Self-hosted OpenAI-compatible embeddings server (Phase 7), e.g. http://vllm:8000/v1.
EMBEDDING_BASE_URL=
# In-process sentence-transformers model (Phase 7). NOTE: a different embedding model
# usually means a different vector dimension — set EMBEDDING_DIMENSIONS to match AND
# re-ingest into a fresh DB (the pgvector column dimension is fixed at ingestion time).
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking (LlamaIndex SentenceSplitter), in tokens.
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# ── Hybrid retrieval + re-ranking (Phase 2) ─────────────────────────────────────
HYBRID_VECTOR_CANDIDATES=20
HYBRID_BM25_CANDIDATES=20
FINAL_TOP_K=6
ENABLE_BM25=true
FTS_LANGUAGE=english

# Re-ranker. "cross_encoder" requires the optional extra: `uv sync --extra reranker`
# (pulls sentence-transformers + torch). "fake" is a deterministic dev/test reranker.
# If cross_encoder is selected but the extra is absent, the app falls back to fake.
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_WEIGHT=1.0

# ── Multi-agent workflow + LLM (Phase 3) ────────────────────────────────────────
# Baseline ("cloud") LLM provider:
#   anthropic         — real Claude (needs ANTHROPIC_API_KEY).
#   openai_compatible — a self-hosted endpoint as the baseline (set LLM_BASE_URL).
#   fake              — deterministic dev/test LLM.
# In development a provider with missing prerequisites auto-falls back to "fake".
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-4-6
VERIFIER_MODEL=claude-haiku-4-5
SYNTHESIZER_MODEL=claude-opus-4-8
SYNTHESIS_MAX_TOKENS=4096
CONFIDENCE_THRESHOLD=0.6
MAX_SUBQUERIES=4

# ── Self-hosted LLM + deployment modes (Phase 7) ─────────────────────────────────
# The self-hosted profile used by the model router for sensitive documents (and as the
# baseline in single-tenant / private / air-gapped modes). Configured iff LLM_BASE_URL
# is set — any OpenAI-compatible endpoint (vLLM recommended; Ollama / TGI also work).
# LLM_API_KEY is optional (Ollama needs none).
LLM_BASE_URL=
LLM_API_KEY=
SELF_HOSTED_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Deployment mode: "saas" | "single_tenant" | "private_cloud" | "air_gapped".
# In private_cloud / air_gapped the app REFUSES to start if any cloud provider
# (anthropic LLM, openai embeddings, hosted Langfuse, cloud RAGAS judge) is selected.
DEPLOYMENT_MODE=saas
# Documents at/above this classification route to the self-hosted profile (SaaS default;
# per-tenant overridable via the tenant settings admin API).
SENSITIVE_CLASSIFICATION=confidential

# ── Observability (Langfuse) — Phase 6 ───────────────────────────────────────────
# "langfuse" needs the optional extra (`uv sync --extra observability`) + the keys
# below; "fake" is a no-op tracer. Falls back to "fake" when the extra/keys are absent.
OBSERVABILITY_PROVIDER=langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Privacy-first: traces carry only metadata by default. Set true to also capture
# prompts/answers/retrieved context (sends document-derived content to Langfuse).
LANGFUSE_CAPTURE_IO=false

# ── Compliance + API security (Phase 6) ──────────────────────────────────────────
DATA_REGION=us
API_KEY_PREFIX=edip
RATE_LIMIT_PER_MINUTE=120
ENABLE_SECURITY_HEADERS=true

# ── RAGAS evaluation + CI gate (Phase 4) ─────────────────────────────────────────
# "ragas" computes real faithfulness/context_precision/answer_relevancy via an LLM
# judge — needs the optional extra (`uv sync --extra evals`) + ANTHROPIC_API_KEY.
# "fake" is a deterministic offline scorer used by the default test suite + PR gate.
# If "ragas" is selected but the extra is absent (or no key in development), the app
# falls back to "fake".
EVALS_PROVIDER=ragas
EVAL_JUDGE_MODEL=claude-sonnet-4-6
EVAL_TENANT_SLUG=eval-harness
EVAL_TENANT_OWNER_EMAIL=owner@eval-harness.internal
EVAL_DATASET_PATH=../evals/ground_truth.json
# A run passes only if every mean metric is >= its threshold (the deploy gate).
EVAL_THRESHOLD_FAITHFULNESS=0.7
EVAL_THRESHOLD_CONTEXT_PRECISION=0.7
EVAL_THRESHOLD_ANSWER_RELEVANCY=0.7
